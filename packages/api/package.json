{
  "name": "@yenihaber/api",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js",
      "default": "./dist/health.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@yenihaber/config": "workspace:*",
    "@yenihaber/database": "workspace:*",
    "@yenihaber/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "nodemailer": "^9.0.5",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
