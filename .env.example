# Haber düzeltme / hata bildirimi e-posta
NEXT_PUBLIC_CORRECTION_EMAIL=duzeltme@duzceradikal.com
# API sunucusunun bülten onay linki üretirken kullandığı origin
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_NAME=Düzce Radikal

# Üye haber yayın e-postası (opsiyonel)
# SMTP yoksa API log'a yazar. Webhook veya SMTP seçin.
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_SECRET=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Düzce Radikal <noreply@duzceradikal.com>"

# CollectAPI (nöbetçi eczane) — yalnızca sunucu; asla NEXT_PUBLIC_ yazma
