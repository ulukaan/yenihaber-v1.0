REVALIDATE_SECRET=degistir-revalidate-gizli
WEB_REVALIDATE_URL=http://localhost:3000
# Faz 3 yüzeyleri (varsayılan kapalı — yayına çıkarken açma)
# NEXT_PUBLIC_FEATURE_STORIES=1
# NEXT_PUBLIC_FEATURE_POLLS=1
# NEXT_PUBLIC_FEATURE_ELECTIONS=1
# İhbar hattı (ülke kodu ile, örn. 90555...)
